{
  "name": "byline",
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "safe_area": [
      0,
      250,
      1080,
      1670
    ]
  },
  "fonts": {
    "sans": {
      "family": "Inter Tight",
      "weight": 600,
      "tracking": -0.03,
      "source": "Google Fonts (OFL)",
      "file": "InterTight.ttf"
    },
    "serif": {
      "family": "Instrument Serif",
      "style": "italic",
      "tracking": -0.04,
      "source": "Google Fonts (OFL)",
      "file": "InstrumentSerif-Italic.ttf"
    }
  },
  "colors": {
    "white": "#FFFFFF",
    "black": "#0A0A0A",
    "paper": "#FAFAFA",
    "ghost": "rgba(255,255,255,0.35)",
    "chip_blue": [
      "#2F7BFF",
      "#5AA8FF"
    ],
    "chip_blue_glow": "rgba(60,140,255,0.55)",
    "chip_red": [
      "#FF3D55",
      "#FF7A88"
    ],
    "chip_red_glow": "rgba(255,70,90,0.55)"
  },
  "captions": {
    "words_per_caption": [
      1,
      3
    ],
    "y_rule": "chin_y + 0.17*H, clamped to 0.44H..0.62H",
    "sans_px": 74,
    "serif_px": 136,
    "ghost_px": 50,
    "ghost_offset_px": -78,
    "shadow": "0 2px 6px rgba(0,0,0,0.6)",
    "serif_glow": "0 0 18px rgba(255,255,255,0.35)",
    "enter": {
      "frames": 5,
      "blur_px": [
        14,
        0
      ],
      "scale": [
        0.88,
        1.04,
        1.0
      ],
      "opacity": [
        0,
        1
      ]
    },
    "exit": "cut",
    "emphasis_share": "1 power word per sentence, max 1 per 2 s"
  },
  "word_cards": {
    "black": {
      "bg": "#0A0A0A",
      "font": "sans",
      "px": 84,
      "color": "#FFFFFF"
    },
    "white": {
      "bg": "#FAFAFA",
      "font": "serif",
      "px": 156,
      "color": "#0A0A0A"
    },
    "per_word_s": [
      0.35,
      1.2
    ],
    "run_words": [
      1,
      5
    ],
    "alternate": true,
    "enter": {
      "frames": 5,
      "blur_px": [
        16,
        0
      ],
      "scale": [
        0.92,
        1.0
      ]
    },
    "every_s": [
      8,
      15
    ],
    "sfx": "deep_whoosh"
  },
  "chips": {
    "radius": "pill",
    "padding_px": [
      20,
      40
    ],
    "font": "serif",
    "px": 70,
    "text": "#FFFFFF",
    "inner_highlight": "top 40% white 18%",
    "glow_px": 30,
    "enter": {
      "frames": 6,
      "scale": [
        0.0,
        1.12,
        1.0
      ]
    },
    "stack_gap_px": 18,
    "hold": "until the list ends + 0.5 s",
    "sfx": "pop"
  },
  "camera": {
    "punch_in_scale": [
      1.0,
      1.12
    ],
    "punch_every_s": [
      1.2,
      2.5
    ],
    "after_cut_flash": {
      "brightness": 0.08,
      "decay_frames": 12
    },
    "transition": {
      "type": "zoom_blur",
      "frames": 4,
      "scale": [
        1.0,
        1.06
      ],
      "blur": "radial"
    },
    "max_unchanged_s": 3.0
  },
  "bw_punch": {
    "trigger": "negative / mistake / 'wrong' phrase",
    "zoom": 1.04,
    "sfx": "glitch"
  },
  "cta": {
    "small": "comment",
    "small_px": 52,
    "big_px": 170,
    "big_font": "serif",
    "uppercase": true,
    "quotes": true,
    "sfx": [
      "whoosh",
      "low_hit"
    ]
  },
  "audio": {
    "dead_air": {
      "silence_db": -35,
      "min_gap_s": 0.25,
      "keep_pad_s": 0.06
    },
    "voice_lufs": -14,
    "music": {
      "optional": true,
      "bpm": [
        85,
        95
      ],
      "level_db_under_voice": -26,
      "duck": "sidechain, fast attack"
    },
    "sfx_levels_db": {
      "deep_whoosh": -14,
      "whoosh": -17,
      "pop": -18,
      "click": -20,
      "glitch": -18,
      "low_hit": -15
    }
  },
  "pacing": {
    "avg_shot_s": [
      1.2,
      2.0
    ],
    "visual_changes_per_min": [
      35,
      40
    ]
  }
}