# Claude (edit decisions)
ANTHROPIC_API_KEY=
# CUTTIT_CLAUDE_MODEL=claude-opus-5-5

# Gemini (speech-to-text). Get a key at https://aistudio.google.com/apikey
# The Gemini app subscription does not include API access.
GEMINI_API_KEY=
# CUTTIT_GEMINI_MODEL=gemini-3.8-flash

# Supabase / Postgres
DATABASE_URL=postgresql://user:pass@host:5432/postgres

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cuttit

# Captions: a font that covers Malayalam, and the folder it's in (optional)
CUTTIT_CAPTION_FONT=Noto Sans Malayalam
# CUTTIT_FONTS_DIR=/usr/share/fonts/truetype/noto

# WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=pick-any-secret-word
WHATSAPP_APP_SECRET=
# Payment page or UPI link shown to new clients, and your own number for alerts
CUTTIT_PAYMENT_LINK=
CUTTIT_ADMIN_PHONE=+91
